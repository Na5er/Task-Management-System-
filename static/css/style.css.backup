/* ========== GLOBAL STYLES ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #667eea;
    --primary-dark: #5568d3;
    --primary-light: rgba(102, 126, 234, 0.1);
    --secondary: #764ba2;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --dark: #1f2937;
    --light: #f9fafb;
    --bg-light: #f3f4f6;
    --bg-medium: #e5e7eb;
    --border: #e5e7eb;
    --text: #374151;
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text);
    background: var(--light);
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ========== BUTTONS ========== */
.btn {
    display: inline-block;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
}

.btn-outline:hover {
    background: var(--primary);
    color: white;
}

.btn-large {
    padding: 16px 32px;
    font-size: 16px;
}

.btn-small {
    padding: 8px 16px;
    font-size: 12px;
}

.btn-block {
    width: 100%;
    display: block;
}

/* ========== LANDING PAGE ========== */
.landing-page {
    min-height: 100vh;
}

.navbar {
    background: white;
    box-shadow: var(--shadow);
    padding: 20px 0;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 24px;
    color: var(--primary);
}

.nav-links {
    display: flex;
    gap: 16px;
}

.hero {
    padding: 100px 0;
    text-align: center;
    background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
    position: relative;
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: url('/static/img/hero-bg.jpg') center center/cover no-repeat;
    filter: brightness(0.7);
}

.hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.8) 0%, rgba(118, 75, 162, 0.8) 100%);
    z-index: 1;
}

.hero .container,
.hero-content {
    position: relative;
    z-index: 2;
}

.hero-content {
    background: none;
    border-radius: 0;
    padding: 80px 0 60px 0;
}

.hero-title,
.hero-subtitle {
    color: #fff;
    text-shadow: 0 2px 16px rgba(43, 35, 102, 0.18), 0 1px 4px rgba(0, 0, 0, 0.12);
}

.hero-title {
    font-size: 56px;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #7a3fb1 0%, #ff3cac 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 20px;
    color: #f3f4f6;
    max-width: 600px;
    margin: 0 auto 40px;
}

.hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
}

.features {
    padding: 80px 0;
}

.section-title {
    text-align: center;
    font-size: 36px;
    margin-bottom: 60px;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.feature-card {
    background: white;
    padding: 40px 30px;
    border-radius: 16px;
    box-shadow: var(--shadow);
    text-align: center;
    transition: transform 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-8px);
}

.feature-icon {
    font-size: 48px;
    margin-bottom: 20px;
}

.feature-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
}

.feature-card p {
    color: var(--text-light);
}

.cta {
    padding: 80px 0;
    text-align: center;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
}

.cta h2 {
    font-size: 36px;
    margin-bottom: 16px;
}

.cta p {
    font-size: 18px;
    margin-bottom: 32px;
}

footer {
    padding: 40px 0;
    text-align: center;
    background: var(--dark);
    color: white;
}

/* ========== AUTH PAGES ========== */
.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
    padding: 20px;
}

.auth-container {
    width: 100%;
    max-width: 450px;
}

.auth-box {
    background: white;
    padding: 40px;
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
}

.auth-header {
    text-align: center;
    margin-bottom: 30px;
}

.auth-header h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

.auth-header h2 {
    font-size: 24px;
    margin-bottom: 8px;
}

.auth-header p {
    color: var(--text-light);
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 14px;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--primary);
}

.auth-footer {
    margin-top: 24px;
    text-align: center;
}

.auth-footer p {
    margin-bottom: 8px;
    color: var(--text-light);
}

.auth-footer a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
}

.alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.alert-success {
    background: #d1fae5;
    color: #065f46;
}

.alert-error {
    background: #fee2e2;
    color: #991b1b;
}

.alert-info {
    background: #dbeafe;
    color: #1e40af;
}

/* ========== DASHBOARD ========== */
.dashboard {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 280px;
    background: var(--dark);
    color: white;
    display: flex;
    flex-direction: column;
    position: fixed;
    height: 100vh;
    left: 0;
    top: 0;
}

.sidebar-header {
    padding: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-header h1 {
    font-size: 24px;
}

.sidebar-nav {
    flex: 1;
    padding: 20px 0;
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.3s ease;
}

.nav-item:hover,
.nav-item.active {
    background: rgba(255, 255, 255, 0.1);
    color: white;
}

.nav-item .icon {
    font-size: 20px;
}

.nav-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 16px 0;
}

.sidebar-footer {
    padding: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.user-info {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
}

.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.user-details {
    flex: 1;
}

.user-name {
    font-weight: 600;
    font-size: 14px;
}

.user-email {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
}

.main-content {
    margin-left: 280px;
    flex: 1;
    padding: 32px;
    padding-left: 0;
    background: var(--light);
}

/* Dashboard visual enhancements */
.main-content {
    background: linear-gradient(180deg, rgba(250,250,252,1) 0%, rgba(246,246,250,1) 40%);
    transition: background 0.3s ease;
}

.stats-grid .stat-card {
    transition: transform 220ms ease, box-shadow 220ms ease;
    will-change: transform;
}
.stats-grid .stat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(43, 35, 102, 0.08);
}

/* animate stat values with a subtle fade */
.stat-value { font-size: 28px; font-weight: 800; transition: color 200ms ease; }

/* New Task floating button style */
.header-right .btn-primary {
    background: linear-gradient(90deg, #6b3f9a 0%, #ff3cac 100%);
    border-radius: 10px;
    padding: 10px 14px;
    box-shadow: 0 8px 24px rgba(107,63,154,0.16);
    transition: transform 160ms ease, box-shadow 160ms ease;
}
.header-right .btn-primary:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(107,63,154,0.2); }

/* Task card hover */
.task-card { transition: transform 220ms ease, box-shadow 220ms ease, border-left-color 220ms ease; }
.task-card:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(43, 35, 102, 0.06); }

/* Sidebar nav hover effects */
.sidebar .nav-item { transition: background 160ms ease, color 160ms ease; }
.sidebar .nav-item:hover { background: rgba(255,255,255,0.03); color: white; }

/* Floating add button for mobile (if desired) */
.floating-add {
    position: fixed; right: 28px; bottom: 28px; z-index: 1600;
}


.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.header-left h2 {
    font-size: 32px;
    margin-bottom: 4px;
}

.header-left p {
    color: var(--text-light);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
}

.stat-card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    display: flex;
    align-items: center;
    gap: 16px;
}

.stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

.stat-value {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 4px;
}

.stat-label {
    color: var(--text-light);
    font-size: 14px;
}

.filters-bar {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
}

.search-input,
.filter-select {
    padding: 12px 16px;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    background: white;
}

.search-input {
    flex: 1;
}

.filter-select {
    min-width: 180px;
}

.tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 24px;
}

.task-card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease;
    position: relative;
    border-left: 4px solid var(--border);
}

.task-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.task-card.priority-high {
    border-left-color: var(--danger);
}

.task-card.priority-medium {
    border-left-color: var(--warning);
}

.task-card.priority-low {
    border-left-color: var(--success);
}

.task-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 12px;
}

.task-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

.task-actions {
    display: flex;
    gap: 8px;
}

.task-action-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 18px;
    padding: 4px;
    border-radius: 4px;
    transition: background 0.3s ease;
}

.task-action-btn:hover {
    background: var(--light);
}

.task-description {
    color: var(--text-light);
    font-size: 14px;
    margin-bottom: 16px;
    line-height: 1.5;
}

.task-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
}

.task-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.badge-status {
    background: #dbeafe;
    color: #1e40af;
}

.badge-status.todo {
    background: #f3f4f6;
    color: #374151;
}

.badge-status.in_progress {
    background: #fef3c7;
    color: #92400e;
}

.badge-status.completed {
    background: #d1fae5;
    color: #065f46;
}

.badge-priority {
    background: #fee2e2;
    color: #991b1b;
}

.badge-priority.medium {
    background: #fed7aa;
    color: #9a3412;
}

.badge-priority.low {
    background: #d1fae5;
    color: #065f46;
}

.task-deadline {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-light);
    font-size: 13px;
    margin-bottom: 12px;
}

.task-deadline.overdue {
    color: var(--danger);
    font-weight: 600;
}

.task-assignee {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-light);
}

.assignee-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: white;
    font-weight: 600;
}

.empty-state {
    text-align: center;
    padding: 80px 20px;
}

/* --- Perfect Dashboard Redesign --- */

/* Vibrant animated background */
.page-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
        radial-gradient(circle at 20% 30%, #7a3fb1 0%, transparent 60%),
        radial-gradient(circle at 80% 70%, #ff3cac 0%, transparent 60%),
        linear-gradient(120deg, #2d1856 0%, #7a3fb1 60%, #ff3cac 100%);
    opacity: 1;
    transition: opacity 300ms ease;
    filter: blur(0.5px) saturate(120%);
    animation: bgShift 22s ease-in-out infinite;
}
@keyframes bgShift {
    0% { filter: blur(0.5px) saturate(120%) brightness(1); }
    50% { filter: blur(2px) saturate(140%) brightness(1.08); }
    100% { filter: blur(0.5px) saturate(120%) brightness(1); }
}

/* Sidebar glass and shadow */
.sidebar {
    background: rgba(31,41,55,0.92);
    box-shadow: 0 8px 32px rgba(43,35,102,0.18);
    border-right: 2px solid rgba(122,63,177,0.08);
}

/* Main content transparent for background */
.main-content {
    background: transparent !important;
}

/* Stat cards glassmorphism */
.stat-card {
    background: rgba(255,255,255,0.72);
    border-radius: 18px;
    box-shadow: 0 8px 32px rgba(122,63,177,0.10), 0 2px 8px rgba(80,26,110,0.08);
    backdrop-filter: blur(8px) saturate(120%);
    border: 1.5px solid rgba(122,63,177,0.08);
    transition: transform 220ms cubic-bezier(.2,.9,.3,1), box-shadow 220ms ease;
}
.stats-grid .stat-card:hover {
    transform: translateY(-8px) scale(1.04);
    box-shadow: 0 28px 60px rgba(122,63,177,0.18);
}
.stat-icon {
    border-radius: 16px;
    font-size: 28px;
    box-shadow: 0 2px 8px rgba(122,63,177,0.10);
    border: 2px solid rgba(122,63,177,0.12);
}

/* Task cards glassmorphism */
.task-card {
    background: rgba(255,255,255,0.82);
    border-radius: 18px;
    box-shadow: 0 8px 32px rgba(122,63,177,0.10), 0 2px 8px rgba(80,26,110,0.08);
    transition: transform 0.3s cubic-bezier(.2,.9,.3,1), box-shadow 0.3s ease;
    backdrop-filter: blur(8px) saturate(120%);
    border: 1.5px solid rgba(122,63,177,0.08);
    will-change: transform, opacity;
}
.task-card:hover {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 28px 60px rgba(122,63,177,0.18);
}

/* Floating empty state */
.empty-state {
    background: rgba(255,255,255,0.68);
    border-radius: 18px;
    box-shadow: 0 8px 32px rgba(122,63,177,0.10);
    backdrop-filter: blur(6px) saturate(120%);
    margin-top: 32px;
    animation: floatEmpty 2.8s ease-in-out infinite;
}
@keyframes floatEmpty {
    0% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
    100% { transform: translateY(0); }
}

/* Modern FAB with ripple */
.fab {
    overflow: hidden;
    transition: transform 220ms cubic-bezier(.2,.9,.3,1), box-shadow 220ms ease, opacity 220ms ease;
}
.fab:hover { transform: translateY(-8px) scale(1.08); box-shadow: 0 36px 74px rgba(122,63,177,0.22); }
.fab:active { transform: translateY(-2px) scale(.99); }
.fab:focus { outline: 2px solid #ff3cac; }
.fab::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    background: rgba(255,255,255,0.18);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.3s cubic-bezier(.2,.9,.3,1), height 0.3s cubic-bezier(.2,.9,.3,1);
    z-index: 1;
}
.fab:active::after {
    width: 120px;
    height: 120px;
}

/* ========== MODAL ========== */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-content {
    background: white;
    opacity: 0;
    transform: translateY(32px) scale(0.98);
    animation: authFadeIn 0.7s cubic-bezier(.6,.2,.3,1.1) 0.1s forwards;
    border-radius: 16px;
    width: 90%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
}

/* Split-screen auth fade-in for new design */
.auth-container {
    opacity: 0;
    transform: translateY(32px) scale(0.98);
    animation: authFadeIn 0.7s cubic-bezier(.6,.2,.3,1.1) 0.1s forwards;
}

@keyframes authFadeIn {
    from {
        opacity: 0;
        transform: translateY(32px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--border);
}

.modal-header h3 {
    font-size: 24px;
}

.modal-close {
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    color: var(--text-light);
    padding: 0;
    width: 32px;
    height: 32px;
    line-height: 1;
}

.modal-close:hover {
    color: var(--text);
}

.modal-content form {
    padding: 24px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.modal-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 24px;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
    .hero-title {
        font-size: 36px;
    }

    .hero-content {
        padding: 40px 0 30px 0;
    }

    .sidebar {
        width: 100%;
        position: relative;
        height: auto;
    }

    .main-content {
        margin-left: 0;
    }

    .dashboard {
        flex-direction: column;
    }

    .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .filters-bar {
        flex-direction: column;
    }

    .tasks-grid {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }
}
/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
    .hero-title {
        font-size: 36px;
    }

    .hero-content {
        padding: 40px 0 30px 0;
    }

    .sidebar {
        width: 100%;
        position: relative;
        height: auto;
    }

    .main-content {
        margin-left: 0;
    }

    .dashboard {
        flex-direction: column;
    }

    .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .filters-bar {
        flex-direction: column;
    }

    .tasks-grid {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }
}

/* ========== DEADLINE WARNING MESSAGE ========== */
.deadline-warning {
    /* fixed at top-center of viewport */
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1400;
    width: 50%;
    max-width: 1100px;
    min-width: 360px;
    padding: 22px 28px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-weight: 900;
    font-size: 34px;
    line-height: 1.05;
    /* white glass background with blur - fallback to translucent white */
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(0,0,0,0.06);
    color: var(--dark);
    box-shadow: 0 20px 60px rgba(2, 6, 23, 0.18);
    backdrop-filter: blur(6px) saturate(120%);
    -webkit-backdrop-filter: blur(6px) saturate(120%);
    text-align: center;
}

.deadline-warning .deadline-content { text-align: center; }

.deadline-actions { display: flex; gap: 12px; align-items: center; justify-content: center; }
.deadline-go {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    color: white;
    border: none;
    padding: 12px 18px;
    font-size: 18px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 800;
}
.deadline-go:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

.deadline-warning .deadline-dismiss {
    position: relative;
    right: auto;
    top: auto;
    background: rgba(0,0,0,0.18);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--light);
    font-size: 18px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
}

.deadline-warning i {
    font-size: 20px;
    opacity: 0.95;
}

.deadline-warning .deadline-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.deadline-warning .deadline-dismiss {
    position: absolute;
    right: 14px;
    top: 14px;
    background: rgba(0,0,0,0.18);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--light);
    font-size: 18px;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
}

.deadline-warning .deadline-dismiss:hover {
    background: rgba(0,0,0,0.26);
}


/* highlight for target task after clicking the alert */
.task-highlight {
    animation: taskPulse 1s ease-in-out 3;
    box-shadow: 0 8px 30px rgba(102, 126, 234, 0.18) !important;
    transform: translateY(-2px);
}

.deadline-actions { display: flex; gap: 12px; align-items: center; }
.deadline-go {
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    color: white;
    border: none;
    padding: 10px 16px;
    font-size: 16px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
}
.deadline-go:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

@keyframes taskPulse {
    0% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.18); }
    50% { box-shadow: 0 12px 40px rgba(102, 126, 234, 0.16); }
    100% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0); }
}

/* gentle appear animation */
.deadline-warning {
    opacity: 0;
    transition: opacity 0.3s ease;
}

.deadline-warning.show {
    opacity: 1;
    animation: slideDownFade 0.6s ease forwards;
}

@keyframes slideDownFade {
    from { opacity: 0; transform: translateX(-50%) translateY(-12px) scale(0.98); }
    to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
}

/* Responsive: on narrow screens make it full width with comfortable padding */
@media (max-width: 900px) {
    .deadline-warning {
        /* on small screens center horizontally and reduce size, but not vertically center to avoid covering content */
        width: calc(100% - 32px);
        left: 50%;
        transform: translateX(-50%);
        top: 12px;
        min-width: 0;
        font-size: 18px;
        padding: 12px 16px;
        border-radius: 10px;
    }
}

/* Approaching tasks modal styles */
.approaching-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(2,6,23,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1600;
}
.approaching-modal {
    width: 560px;
    max-width: calc(100% - 48px);
    background: rgba(255,255,255,0.98);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(2,6,23,0.35);
    padding: 18px;
    overflow: hidden;
}
.approaching-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
}
.approaching-modal-header h3 {
    font-size: 18px;
    color: var(--dark);
}
.approaching-close {
    background: transparent;
    border: none;
    font-size: 18px;
    cursor: pointer;
}
.approaching-list {
    max-height: 320px;
    overflow: auto;
    padding: 12px 4px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.approaching-item {
    padding: 12px 14px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.08s ease;
}
.approaching-item:hover {
    background: rgba(102,126,234,0.06);
    transform: translateY(-2px);
}
.approaching-title {
    font-weight: 700;
    color: var(--dark);
}
.approaching-meta {
    color: var(--text-light);
    font-size: 13px;
}

@media (max-width: 600px) {
    .approaching-modal { width: calc(100% - 32px); }
}

/* ========== INBOX / NOTIFICATIONS ========== */
.header-actions { display: flex; align-items: center; gap: 12px; }
.inbox-badge {
    background: var(--danger);
    color: white;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    margin-left: 8px;
}
.inbox-dropdown {
    position: absolute;
    right: 0;
    top: 100%;
    width: 320px;
    max-height: 420px;
    overflow: auto;
    background: white;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    z-index: 2000;
    padding: 8px;
    margin-top: 8px;
}
.inbox-item {
    padding: 10px 12px;
    border-radius: 8px;
    display: flex;
    gap: 8px;
    align-items: start;
    cursor: pointer;
}
.inbox-item.unread { background: rgba(102,126,234,0.06); }
.inbox-item:hover { background: rgba(0,0,0,0.03); }
.inbox-item .meta { font-size: 12px; color: var(--text-light); }
.inbox-item .msg { font-weight: 600; color: var(--dark); }
.inbox-empty { padding: 16px; color: var(--text-light); text-align: center; }

/* ====== NEW: Split login/register design ====== */
.auth-split-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 10% 10%, rgba(120,68,196,0.08), transparent 8%),
                linear-gradient(180deg, #0f0720 0%, #10041a 12%, #f7f7fb 100%);
    padding: 40px 20px;
}

.auth-card {
    width: 1000px;
    max-width: 95%;
    min-height: 480px;
    border-radius: 18px;
    display: grid;
    grid-template-columns: 420px 1fr;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(2,6,23,0.6);
}

.auth-left {
    background: linear-gradient(180deg, #12071b 0%, #231034 100%);
    color: #e6e6f0;
    padding: 46px 36px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    justify-content: center;
}

.auth-right {
    position: relative;
    background: url('/static/img/hero-bg.jpg') center center/cover no-repeat;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.auth-right::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(63, 42, 155, 0.85) 0%, rgba(122, 63, 177, 0.85) 50%, rgba(107, 63, 154, 0.85) 100%);
    z-index: 1;
}

.auth-right .decor { 
    width: 100%; 
    height: 100%; 
    position: relative; 
    display: none; 
}

.swirl {
    position: absolute;
    left: -20px;
    top: -8px;
    width: 520px;
    height: 360px;
    z-index: 5;
    filter: blur(18px) saturate(140%);
    opacity: 0.95;
}

.auth-right .hero { 
    position: relative; 
    z-index: 12; 
    max-width: 420px; 
    padding: 40px; 
    text-align: left; 
}

.auth-right .hero { position: relative; z-index: 10; max-width: 420px; padding: 40px; text-align: left; }
.auth-right h1 { font-size: 44px; margin: 0 0 12px 0; font-weight: 800; }
.auth-right p { opacity: 0.95; color: rgba(255,255,255,0.9); }

.auth-left .avatar { width:72px; height:72px; border-radius:50%; background:linear-gradient(90deg,#6f42c1,#00d4ff); display:flex; align-items:center; justify-content:center; font-weight:800; color:white; margin-bottom:6px; }
.auth-left h2 { font-size:28px; margin: 6px 0 8px; color: #fff; }
.auth-left .desc { color: rgba(255,255,255,0.75); margin-bottom: 18px; }
.auth-left .form-group { width: 100%; margin-bottom: 12px; }
.auth-left input { width: 100%; padding: 12px 14px; border-radius: 10px; border: none; background: rgba(255,255,255,0.06); color: #fff; }
.auth-left input::placeholder { color: rgba(255,255,255,0.6); }
.auth-left label { color: rgba(255,255,255,0.8); font-size:13px; margin-bottom:6px; display:block; }

.btn-accent { display:inline-block; padding: 12px 20px; border-radius: 10px; border: none; background: linear-gradient(90deg,#ff3cac 0%,#7844c4 100%); color: white; font-weight:800; cursor:pointer; }
.btn-accent:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(120,68,196,0.25); }

.auth-left .muted { color: rgba(255,255,255,0.7); font-size: 14px; }

@media (max-width: 900px) {
    .auth-card { grid-template-columns: 1fr; width: 92%; }
    .auth-right { display: none; }
    .auth-left { padding: 28px; }
}

/* ensure the older auth styles don't interfere: hide the center backplate if present */
.auth-animated-page::before { display: none !important; }

/* ====== Subtle UI polish & animations ====== */
.auth-card {
    animation: cardEntrance 520ms cubic-bezier(.2,.9,.3,1) both;
}

@keyframes cardEntrance {
    from { transform: translateY(18px) scale(0.995); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

.auth-left input:focus {
    outline: none;
    box-shadow: 0 6px 24px rgba(102,126,234,0.12), inset 0 1px 0 rgba(255,255,255,0.02);
    transform: translateY(-1px);
}

.btn-accent { transition: transform .18s ease, box-shadow .18s ease; }

/* gentle float for the decorative swirl */
.swirl { transform-origin: center; animation: swirlFloat 6s ease-in-out infinite; }
@keyframes swirlFloat {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.02); }
    100% { transform: translateY(0) scale(1); }
}

/* respect user preference for reduced motion */
@media (prefers-reduced-motion: reduce) {
    .auth-card { animation: none !important; }
    .swirl { animation: none !important; }
}



/* ========== AUTH ANIMATED (login/register) ========== */
/* A white-panel on a subtle fading purple background that matches the landing page */
.auth-animated-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(118,75,162,0.06) 0%, rgba(102,126,234,0.04) 40%, rgba(255,255,255,0.0) 100%);
    padding: 40px 20px;
}

.auth-animated-page { position: relative; }

/* main container for the animated split auth UI */
#container {
    background: transparent;
    width: 560px;
    max-width: 95%;
    min-height: 420px;
    position: relative;
    overflow: visible;
    border-radius: 16px;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-items: center;
    gap: 0;
}

#authMessage {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    text-align: center;
    pointer-events: none;
    z-index: 60;
}

/* Centered purple backplate behind the card to keep the visual effect
   while keeping the auth card horizontally centered in the viewport. */
.auth-animated-page::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 520px;
    height: 620px;
    background: linear-gradient(180deg, rgba(102,126,234,1) 0%, rgba(118,75,162,1) 100%);
    border-radius: 14px;
    z-index: 20;
    box-shadow: 0 20px 60px rgba(118,75,162,0.12);
    opacity: 0.98;
}

/* Ensure the container and forms sit above the backplate */
#container { z-index: 30; display: grid; }
.form-container { z-index: 40; position: relative; }
.overlay-container { z-index: 25; position: absolute; right: 0; top: 0; bottom: 0; }

/* When viewport is narrow, hide the decorative backplate to avoid overlap */
@media (max-width: 900px) {
    .auth-animated-page::before { display: none; }
}

.form-container {
    background: rgba(255,255,255,0.98);
    padding: 36px 28px;
    box-shadow: 0 20px 60px rgba(2,6,23,0.06);
    border-radius: 12px;
    width: 420px;
    transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
}

.form-container h1 { margin-bottom: 24px; color: var(--dark); }
.form-container input {
    display: block;
    width: 100%;
    padding: 12px 14px;
    margin-bottom: 16px;
    border-radius: 8px;
    border: 1px solid rgba(15,23,42,0.06);
    background: #fff;
}
.form-container button {
    width: 100%;
    padding: 12px 18px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(90deg, rgba(102,126,234,1) 0%, rgba(118,75,162,1) 100%);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
}
.form-container button:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

.overlay-container {
    /* hide decorative overlay to avoid shifting the centered card */
    display: none;
}

.overlay {
    background: linear-gradient(90deg, rgba(102,126,234,0.95) 0%, rgba(118,75,162,0.95) 100%);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    padding: 40px;
    box-shadow: -20px 20px 60px rgba(118,75,162,0.12);
    border-radius: 0 12px 12px 0;
    pointer-events: auto;
}

.overlay-panel { max-width: 320px; text-align: center; }
.overlay-panel h1 { margin-bottom: 12px; font-size: 28px; }
.overlay-panel p { margin-bottom: 24px; color: rgba(255,255,255,0.9); }
.overlay-panel .ghost {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.85);
    color: white;
    padding: 10px 22px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
}
.overlay-panel .ghost:hover { background: rgba(255,255,255,0.06); }

/* States: when the container has this class, show register panel on left */
#container.right-panel-active .register-container { transform: translateX(0); opacity: 1; z-index: 2; }
#container.right-panel-active .login-container { transform: translateX(-20%); opacity: 0.0; z-index: 1; }
#container.right-panel-active .overlay-container { transform: translateX(-100%); }

#container .register-container,
#container .login-container { display: none; }

#container.right-panel-active .register-container { display: block; }
#container.right-panel-active .login-container { display: none; }
#container:not(.right-panel-active) .login-container { display: block; }
#container:not(.right-panel-active) .register-container { display: none; }

/* Adjust layout on small screens */
@media (max-width: 900px) {
    #container { grid-template-columns: 1fr; min-height: auto; }
    .overlay-container { position: relative; width: 100%; height: 180px; border-radius: 12px; }
    .overlay { border-radius: 12px; }
    .register-container, .login-container { transform: none; opacity: 1; }
}

/* ===================== DASHBOARD EXTRA EFFECTS ===================== */

/* Animated soft gradient background behind the app for depth. */
.page-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(120deg, rgba(107,63,154,0.06) 0%, rgba(255,60,160,0.04) 35%, rgba(102,126,234,0.04) 70%);
    opacity: 1;
    transition: opacity 300ms ease;
}

/* subtle slow animated shift for the background gradient */
@keyframes bgShift {
    0% { filter: hue-rotate(0deg) saturate(100%) blur(0px); transform: translateY(0px) scale(1); }
    50% { filter: hue-rotate(8deg) saturate(110%) blur(2px); transform: translateY(-6px) scale(1.01); }
    100% { filter: hue-rotate(0deg) saturate(100%) blur(0px); transform: translateY(0px) scale(1); }
}
.page-bg { animation: bgShift 18s ease-in-out infinite; }

/* Floating Action Button (FAB) */
.fab {
    position: fixed;
    right: 28px;
    bottom: 28px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: white;
    cursor: pointer;
    z-index: 1700;
    background: linear-gradient(135deg, #7a3fb1 0%, #ff3cac 100%);
    box-shadow: 0 14px 34px rgba(122,63,177,0.18), 0 6px 18px rgba(80,26,110,0.12);
    transition: transform 220ms cubic-bezier(.2,.9,.3,1), box-shadow 220ms ease, opacity 220ms ease;
}
.fab:hover { transform: translateY(-6px) scale(1.03); box-shadow: 0 26px 54px rgba(122,63,177,0.22); }
.fab:active { transform: translateY(-2px) scale(.99); }

/* gentle float animation */
@keyframes fabFloat { 0% { transform: translateY(0); } 50% { transform: translateY(-6px); } 100% { transform: translateY(0); } }
.fab { animation: fabFloat 6s ease-in-out infinite; }

/* Staggered task-card enter animation */
.task-enter {
    opacity: 0;
    transform: translateY(14px) scale(0.995);
}
@keyframes taskEnter {
    from { opacity: 0; transform: translateY(14px) scale(0.995); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}
.task-enter.task-enter--animate {
    animation: taskEnter 420ms cubic-bezier(.2,.9,.25,1) forwards;
}

/* Hover lift already exists; make sure it composes nicely with the enter animation */
.task-card { will-change: transform, opacity; }

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
    .page-bg, .fab, .task-enter.task-enter--animate { animation: none !important; }
}

/* Slight z-index management so background sits behind the dashboard content */
.dashboard, .main-content, .sidebar { position: relative; z-index: 10; }

/* On very small screens hide the FAB and reduce clutter */
@media (max-width: 640px) {
    .fab { display: none; }
}

/* Small visual tweak: make tasks container have preserve-3d for smoother anim */
.tasks-grid { transform-style: preserve-3d; }

/* ========== Blurred hero image background ========== */
.hero {
    position: relative;
    overflow: hidden;
}
.hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: url('/static/img/hero-bg.jpg') center center/cover no-repeat;
    filter: brightness(0.7);
}
.hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.8) 0%, rgba(118, 75, 162, 0.8) 100%);
    z-index: 1;
}
.hero .container, .hero-content {
    position: relative;
    z-index: 2;
}
.hero-content {
    background: none;
    border-radius: 0;
    padding: 80px 0 60px 0;
    text-align: center;
}
.hero-title, .hero-subtitle {
    color: #fff;
    text-shadow: 0 2px 16px rgba(43,35,102,0.18), 0 1px 4px rgba(0,0,0,0.12);
}
.hero-title {
    font-size: 56px;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #7a3fb1 0%, #ff3cac 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.hero-subtitle {
    font-size: 20px;
    color: #f3f4f6;
    max-width: 600px;
    margin: 0 auto 40px;
}
.hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
}
@media (max-width: 900px) {
    .hero-title { font-size: 36px; }
    .hero-content { padding: 40px 0 30px 0; }
}


